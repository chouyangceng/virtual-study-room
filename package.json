{
  "name": "virtual-study-room",
  "version": "1.2.0",
  "description": "虚拟自习室 · Virtual Study Room",
  "main": "main.js",
  "author": "chouyangceng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "archive:win": "node server/windows-archive.js",
    "build:single": "node tools/build-single-file.mjs",
    "test": "node --test test/archive-core.test.js test/archive-server.test.js",
    "smoke:archive": "node test/http-smoke.mjs",
    "check:js": "node tools/check-js.mjs",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64"
  },
  "build": {
    "appId": "com.vsr.studyroom",
    "productName": "虚拟自习室",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "shared/**/*",
      "server/**/*",
      "icons/**/*",
      "manifest.webmanifest",
      "sw.js"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "icons/icon-512.png"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
