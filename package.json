{
  "name": "virtual-study-room",
  "version": "1.1.0",
  "description": "虚拟自习室 · Virtual Study Room",
  "main": "main.js",
  "author": "chouyangceng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.vsr.studyroom",
    "productName": "虚拟自习室",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "manifest.webmanifest",
      "sw.js"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
